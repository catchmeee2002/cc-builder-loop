              "CC8"
            ]
          }
        },
        {
          "id": "cc-124",
          "source_url": "https://github.com/catchmeee2002/cc-builder-loop/issues/124",
          "title": "E2E case 无 hard_rules 时 mechanical 派生值未传给 Tester",
          "facts": [
            "冻结 case 为 full，包含 must、must_not 与 quality，但没有 hard_rules。",
            "Tester 的七项真实检查均返回 0，并报告 mechanical=pass。",
            "runtime 拒绝记录，要求该结构下 mechanical=not_applicable。",
            "Builder 交接只列出返回字段，没有说明该派生规则。",
            "改成 not_applicable 后 evidence 被接受。"
          ],
          "gold": {
            "diagnosis_state": "established",
            "human_attention": "none",
            "scope_inventory_required": true,
            "cluster_id": "cc-role-contract-projection",
            "principle_ids": [
              "CC2",
              "CC8"
            ]
          }
        },
        {
          "id": "cc-125",
          "source_url": "https://github.com/catchmeee2002/cc-builder-loop/issues/125",
          "title": "Reviewer blocked 后建议 fresh Reviewer，与连续性规则冲突",
          "facts": [
            "Reviewer 首次只因验证顺序证据缺失而 blocked，候选、测试目标和验收标准均未变化。",
            "Reviewer 文本要求补证据后启动 fresh Reviewer。",
            "Builder 的冻结规则要求后续审查续接原 Reviewer thread。",
            "主线程实际续接原 Reviewer 后通过，evidence 绑定原 agent id。",
            "Reviewer 自身角色合同只定义 blocked 输出，未声明 blocked 后的 thread 处理。"
          ],
          "gold": {
            "diagnosis_state": "established",
            "human_attention": "none",
            "scope_inventory_required": true,
            "cluster_id": "cc-role-contract-projection",
            "principle_ids": [
              "CC7",
              "CC8"
            ]
          }
        },
        {
          "id": "cc-91",
          "source_url": "https://github.com/catchmeee2002/cc-builder-loop/issues/91",
          "title": "Planner 应在什么条件下比较重大方案并保留演进通道",
          "facts": [
            "局部可逆任务若强制比较多个方案，会增加明显规划成本。",
            "高影响、难回退且存在真实分叉的任务，如果不比较方案，可能过早冻结单一路径。",
            "为未知未来预置抽象会违反最小充分，但完全不考虑已经明确的下一阶段可能堵死演进。",
            "需要决定哪些方法应进入 Planner 常驻契约，哪些只按需加载。"
          ],
          "gold": {
            "diagnosis_state": "established",
            "human_attention": "first_principles",
            "scope_inventory_required": true,
            "cluster_id": "cc-planning-philosophy",
            "principle_ids": [
              "CC5",
              "CC10",
              "CC11"
            ]
          }
        }
