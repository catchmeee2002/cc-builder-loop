  "projects": [
    {
      "project_id": "cc-builder-loop",
      "goal": "在 Codex 原生推理和调度之下提供不能靠模型自述绕过的独立判据、角色边界、证据与 Git 交付闭环。",
      "principles": [
        {
          "id": "CC1",
          "text": "机器、Tester、Reviewer 判据按独立性分层，并绑定产生结论的真实输入。"
        },
        {
          "id": "CC2",
          "text": "每个事实只有一个家；消费者引用权威源，不维护旁路副本。"
        },
        {
          "id": "CC4",
          "text": "改输入条件，不堆输出特判。"
        },
        {
          "id": "CC5",
          "text": "保持最小充分；只为当前行为或明确演进压力增加结构。"
        },
        {
          "id": "CC6",
          "text": "同类问题重复出现说明缺少抽象、边界或正确问题定义，应停止重试并审视架构。"
        },
        {
          "id": "CC7",
          "text": "连续性属于原 thread 和事务身份，同名新角色不能冒充续接。"
        },
        {
          "id": "CC8",
          "text": "契约与成熟行为先于实现；公共输入输出和副作用应先冻结。"
        },
        {
          "id": "CC10",
          "text": "出现产品取舍、测试目标变化或无进展时，把决定交还用户。"
        },
        {
          "id": "CC11",
          "text": "设计原则、公共契约或角色边界的增删改必须单独披露并取得用户接受。"
        }
      ],
      "cases": [
        {
          "id": "cc-101",
          "source_url": "https://github.com/catchmeee2002/cc-builder-loop/issues/101",
          "title": "proof worktree 的未跟踪或 ignored 残留未进入清洁判断",
          "facts": [
            "proof 命令在隔离 worktree 中返回预期退出码。",
            "命令可以创建未跟踪 Python 源码或 ignored 缓存，这些文件可能影响后续导入与测试。",
            "原清洁检查只查看 tracked diff。",
            "存在上述残留时，旧流程仍可以记录 proof evidence。"
          ],
          "gold": {
            "diagnosis_state": "established",
            "human_attention": "none",
            "scope_inventory_required": false,
            "cluster_id": "cc-proof-evidence-integrity",
            "principle_ids": [
              "CC1",
              "CC8"
            ]
          }
        },
        {
          "id": "cc-122",
          "source_url": "https://github.com/catchmeee2002/cc-builder-loop/issues/122",
          "title": "共享测试断言只检查 READY/NOOP 文本，不再检查进程 returncode",
          "facts": [
            "多处测试把同时检查 rc=0 与成功状态的断言，替换成只检查 stdout JSON status 属于 READY 或 NOOP。",
            "若 CLI 返回非零但最后一行仍含 READY 或 NOOP，测试仍会通过。",
            "正式运行契约要求成功状态同时具有成功进程 returncode。",
            "完整 fixtures 当前仍为绿色。"
          ],
          "gold": {
            "diagnosis_state": "established",
