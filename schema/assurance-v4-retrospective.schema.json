{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openai.local/codex-builder-loop/assurance-v4-retrospective.schema.json",
  "title": "Builder Assurance v4 Session Retrospective",
  "oneOf": [
    {"$ref": "#/$defs/snapshot"},
    {"$ref": "#/$defs/reportInput"},
    {"$ref": "#/$defs/storedReport"},
    {"$ref": "#/$defs/status"}
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "derivationIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtime_commit",
        "retrospective_schema_version",
        "derivation_version",
        "capture_status"
      ],
      "properties": {
        "runtime_commit": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "pattern": "^[0-9a-f]{40}$"}
          ]
        },
        "retrospective_schema_version": {"const": 2},
        "derivation_version": {"const": "assurance-v4-retrospective-v2"},
        "capture_status": {
          "enum": ["captured", "partial", "unavailable"]
        }
      }
    },
    "signalId": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*-[0-9a-f]{16}$"},
    "runtimeIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter", "adapter_commit", "adapter_dirty", "capture_status"],
      "allOf": [
        {
          "if": {"required": ["builder_loop_version"], "properties": {"capture_status": {"const": "captured"}}},
          "then": {"properties": {"builder_loop_version": {"type": "string"}, "adapter_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "adapter_dirty": {"type": "boolean"}}}
        },
        {
          "if": {"required": ["builder_loop_version"], "properties": {"capture_status": {"enum": ["unavailable", "legacy-unavailable"]}}},
          "then": {"properties": {"builder_loop_version": {"type": "null"}, "adapter_commit": {"type": "null"}, "adapter_dirty": {"type": "null"}}}
        }
      ],
      "properties": {
        "builder_loop_version": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"}
          ]
        },
        "adapter": {"enum": ["codex", "claude-code", "unknown"]},
        "adapter_commit": {"oneOf": [{"type": "null"}, {"type": "string", "pattern": "^[0-9a-f]{40}$"}]},
        "adapter_dirty": {"oneOf": [{"type": "null"}, {"type": "boolean"}]},
        "capture_status": {"enum": ["captured", "partial", "unavailable", "legacy-unavailable"]}
      }
    },
    "runFact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id", "phase", "terminal_status", "root_run_id", "mission_revision", "ledger_digest",
        "runtime_identity", "problem_count", "event_count"
      ],
      "properties": {
        "run_id": {"type": "string", "minLength": 1},
        "phase": {"type": "string", "minLength": 1},
        "terminal_status": {"enum": ["finalized", "abandoned", "superseded", "needs-user", "fatal", "continuity-failure"]},
        "root_run_id": {"type": "string", "minLength": 1},
        "mission_revision": {"type": "integer", "minimum": 1},
        "ledger_digest": {"$ref": "#/$defs/sha256"},
        "runtime_identity": {"$ref": "#/$defs/runtimeIdentity"},
        "problem_count": {"type": "integer", "minimum": 0},
        "event_count": {"type": "integer", "minimum": 0}
      }
    },
    "signal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["signal_id", "kind", "severity", "run_ids", "summary", "facts"],
      "properties": {
        "signal_id": {"$ref": "#/$defs/signalId"},
        "kind": {
          "enum": [
            "recorded-problem", "multiple-terminal-roots", "repeated-role-correction",
            "repeated-dispatch", "manual-dispatch-recovery", "failed-evidence",
            "replayed-evidence", "revision-pressure", "runtime-identity-unavailable",
            "malformed-ledger", "terminal-runtime-failure"
          ]
        },
        "severity": {"enum": ["mandatory", "advisory"]},
        "run_ids": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "summary": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "facts": {"type": "object"}
      }
    },
    "snapshotV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "repo_root", "owner_session_id", "runs", "signals", "snapshot_digest"],
      "properties": {
        "schema_version": {"const": 1},
        "repo_root": {"type": "string", "minLength": 1},
        "owner_session_id": {"type": "string", "minLength": 1},
        "runs": {"type": "array", "items": {"$ref": "#/$defs/runFact"}},
        "signals": {"type": "array", "items": {"$ref": "#/$defs/signal"}},
        "snapshot_digest": {"$ref": "#/$defs/sha256"}
      }
    },
    "snapshotV2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "repo_root", "owner_session_id", "runs", "signals",
        "derivation_identity", "derivation_identity_digest", "snapshot_digest"
      ],
      "properties": {
        "schema_version": {"const": 2},
        "repo_root": {"type": "string", "minLength": 1},
        "owner_session_id": {"type": "string", "minLength": 1},
        "runs": {"type": "array", "items": {"$ref": "#/$defs/runFact"}},
        "signals": {"type": "array", "items": {"$ref": "#/$defs/signal"}},
        "derivation_identity": {"$ref": "#/$defs/derivationIdentity"},
        "derivation_identity_digest": {"$ref": "#/$defs/sha256"},
        "snapshot_digest": {"$ref": "#/$defs/sha256"}
      }
    },
    "snapshot": {
      "oneOf": [
        {"$ref": "#/$defs/snapshotV1"},
        {"$ref": "#/$defs/snapshotV2"}
      ]
    },
    "disposition": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["signal_id", "disposition", "owner", "reference"],
          "properties": {
            "signal_id": {"$ref": "#/$defs/signalId"},
            "disposition": {"const": "issue"},
            "owner": {"enum": ["current_project", "builder_loop", "external_platform"]},
            "reference": {"type": "string", "minLength": 1, "pattern": "\\S"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["signal_id", "disposition", "reason"],
          "properties": {
            "signal_id": {"$ref": "#/$defs/signalId"},
            "disposition": {"const": "not-incident"},
            "reason": {"type": "string", "minLength": 1, "pattern": "\\S"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["signal_id", "disposition", "reason"],
          "properties": {
            "signal_id": {"$ref": "#/$defs/signalId"},
            "disposition": {"const": "needs-user"},
            "reason": {"type": "string", "minLength": 1, "pattern": "\\S"}
          }
        }
      ]
    },
    "issueBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "reference", "signal_ids", "signal_digest"],
      "properties": {
        "owner": {"enum": ["current_project", "builder_loop", "external_platform"]},
        "reference": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "signal_ids": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/signalId"},
          "uniqueItems": true
        },
        "signal_digest": {"$ref": "#/$defs/sha256"}
      }
    },
    "issueUpdateReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner", "reference", "signal_ids", "signal_digest",
        "remote_record_reference", "written_body_digest",
        "read_back_body_digest", "observed_at"
      ],
      "properties": {
        "owner": {"enum": ["current_project", "builder_loop", "external_platform"]},
        "reference": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "signal_ids": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/signalId"},
          "uniqueItems": true
        },
        "signal_digest": {"$ref": "#/$defs/sha256"},
        "remote_record_reference": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "written_body_digest": {"$ref": "#/$defs/sha256"},
        "read_back_body_digest": {"$ref": "#/$defs/sha256"},
        "observed_at": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "format": "date-time"
        }
      }
    },
    "issueSyncStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state", "required_update_count", "verified_update_count",
        "required_bindings", "receipts"
      ],
      "properties": {
        "state": {"enum": ["not-required", "legacy-unverified", "verified"]},
        "required_update_count": {"type": "integer", "minimum": 0},
        "verified_update_count": {"type": "integer", "minimum": 0},
        "required_bindings": {
          "type": "array",
          "items": {"$ref": "#/$defs/issueBinding"},
          "uniqueItems": true
        },
        "receipts": {
          "type": "array",
          "items": {"$ref": "#/$defs/issueUpdateReceipt"},
          "uniqueItems": true
        }
      }
    },
    "reportInputV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "snapshot_digest", "dispositions"],
      "properties": {
        "schema_version": {"const": 1},
        "snapshot_digest": {"$ref": "#/$defs/sha256"},
        "dispositions": {
          "type": "array",
          "items": {"$ref": "#/$defs/disposition"}
        }
      }
    },
    "reportInputV2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "snapshot_digest", "dispositions", "issue_updates"],
      "properties": {
        "schema_version": {"const": 2},
        "snapshot_digest": {"$ref": "#/$defs/sha256"},
        "dispositions": {
          "type": "array",
          "items": {"$ref": "#/$defs/disposition"}
        },
        "issue_updates": {
          "type": "array",
          "items": {"$ref": "#/$defs/issueUpdateReceipt"},
          "uniqueItems": true
        }
      }
    },
    "reportInputV3": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "snapshot_digest", "derivation_identity_digest",
        "dispositions", "issue_updates"
      ],
      "properties": {
        "schema_version": {"const": 3},
        "snapshot_digest": {"$ref": "#/$defs/sha256"},
        "derivation_identity_digest": {"$ref": "#/$defs/sha256"},
        "dispositions": {
          "type": "array",
          "items": {"$ref": "#/$defs/disposition"}
        },
        "issue_updates": {
          "type": "array",
          "items": {"$ref": "#/$defs/issueUpdateReceipt"},
          "uniqueItems": true
        }
      }
    },
    "reportInput": {
      "oneOf": [
        {"$ref": "#/$defs/reportInputV1"},
        {"$ref": "#/$defs/reportInputV2"},
        {"$ref": "#/$defs/reportInputV3"}
      ]
    },
    "storedReportV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "repo_root", "owner_session_id", "snapshot_digest",
        "dispositions", "report_digest", "recorded_at"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "repo_root": {"type": "string", "minLength": 1},
        "owner_session_id": {"type": "string", "minLength": 1},
        "snapshot_digest": {"$ref": "#/$defs/sha256"},
        "dispositions": {"type": "array", "items": {"$ref": "#/$defs/disposition"}},
        "report_digest": {"$ref": "#/$defs/sha256"},
        "recorded_at": {"type": "string", "minLength": 1}
      }
    },
    "storedReportV2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "repo_root", "owner_session_id", "snapshot_digest",
        "dispositions", "issue_updates", "report_digest", "recorded_at"
      ],
      "properties": {
        "schema_version": {"const": 2},
        "repo_root": {"type": "string", "minLength": 1},
        "owner_session_id": {"type": "string", "minLength": 1},
        "snapshot_digest": {"$ref": "#/$defs/sha256"},
        "dispositions": {"type": "array", "items": {"$ref": "#/$defs/disposition"}},
        "issue_updates": {
          "type": "array",
          "items": {"$ref": "#/$defs/issueUpdateReceipt"},
          "uniqueItems": true
        },
        "report_digest": {"$ref": "#/$defs/sha256"},
        "recorded_at": {"type": "string", "minLength": 1}
      }
    },
    "storedReportV3": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "repo_root", "owner_session_id", "snapshot_digest",
        "derivation_identity_digest", "dispositions", "issue_updates",
        "report_digest", "recorded_at"
      ],
      "properties": {
        "schema_version": {"const": 3},
        "repo_root": {"type": "string", "minLength": 1},
        "owner_session_id": {"type": "string", "minLength": 1},
        "snapshot_digest": {"$ref": "#/$defs/sha256"},
        "derivation_identity_digest": {"$ref": "#/$defs/sha256"},
        "dispositions": {
          "type": "array",
          "items": {"$ref": "#/$defs/disposition"}
        },
        "issue_updates": {
          "type": "array",
          "items": {"$ref": "#/$defs/issueUpdateReceipt"},
          "uniqueItems": true
        },
        "report_digest": {"$ref": "#/$defs/sha256"},
        "recorded_at": {"type": "string", "minLength": 1}
      }
    },
    "storedReport": {
      "oneOf": [
        {"$ref": "#/$defs/storedReportV1"},
        {"$ref": "#/$defs/storedReportV2"},
        {"$ref": "#/$defs/storedReportV3"}
      ]
    },
    "status": {
      "type": "object",
      "additionalProperties": true,
      "required": ["status", "owner_session_id"],
      "properties": {
        "status": {"enum": ["NOOP", "ACTIVE", "REQUIRED", "STALE", "NEEDS_USER", "READY", "FATAL"]},
        "owner_session_id": {"type": "string", "minLength": 1},
        "snapshot": {"$ref": "#/$defs/snapshot"},
        "report": {"$ref": "#/$defs/storedReport"},
        "issue_sync": {"$ref": "#/$defs/issueSyncStatus"},
        "required_block": {"type": "string", "minLength": 1},
        "required_user_block": {"type": "string", "minLength": 1},
        "message": {"type": "string", "minLength": 1}
      }
    }
  }
}
