{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openai.local/codex-builder-loop/assurance-v4-evidence.schema.json",
  "title": "Builder Assurance Evidence Report v4",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "status", "candidate_head", "producer", "details"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"enum": ["tester", "proof", "blackbox", "reviewer_preflight", "reviewer", "doc_review"]},
    "status": {"enum": ["pass", "fail"]},
    "candidate_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "agent_id", "thread_id"],
      "properties": {
        "role": {"enum": ["tester", "reviewer"]},
        "agent_id": {"type": "string", "minLength": 1},
        "thread_id": {"type": "string", "minLength": 1}
      }
    },
    "details": {"type": "object"}
  },
  "$defs": {
  "localObservation": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "problem_key",
      "request_digest",
      "acceptance_case_ids",
      "input_head",
      "source_manifest_digest",
      "cwd",
      "before_head",
      "after_head",
      "argv",
      "returncode",
      "timed_out",
      "stdout",
      "stderr"
    ],
    "properties": {
      "problem_key": {
        "type": "string",
        "minLength": 1
      },
      "request_digest": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "acceptance_case_ids": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "input_head": {
        "type": "string",
        "pattern": "^[0-9a-f]{40}$"
      },
      "source_manifest_digest": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "cwd": {
        "type": "string",
        "minLength": 1
      },
      "before_head": {
        "type": "string",
        "pattern": "^[0-9a-f]{40}$"
      },
      "after_head": {
        "type": "string",
        "pattern": "^[0-9a-f]{40}$"
      },
      "argv": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "returncode": {
        "type": "integer"
      },
      "timed_out": {
        "type": "boolean"
      },
      "stdout": {
        "type": "string"
      },
      "stderr": {
        "type": "string"
      }
    }
  },
  "observationDisposition": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "problem_key",
      "request_digest",
      "artifact_digest",
      "accepted",
      "reason"
    ],
    "properties": {
      "problem_key": {
        "type": "string",
        "minLength": 1
      },
      "request_digest": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "artifact_digest": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "accepted": {
        "type": "boolean"
      },
      "reason": {
        "type": "string",
        "minLength": 1
      }
    }
  }
},
  "allOf": [
    {
      "if": {"properties": {"kind": {"enum": ["tester", "proof", "blackbox"]}}},
      "then": {"properties": {"producer": {"properties": {"role": {"const": "tester"}}}}}
    },
    {
      "if": {"properties": {"kind": {"const": "proof"}}},
      "then": {
        "properties": {
          "details": {
            "type": "object",
            "additionalProperties": false,
            "required": ["result", "source_head", "report_digest", "behaviors"],
            "properties": {
              "result": {"enum": ["pass", "fail"]},
              "source_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
              "report_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "behaviors": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
              "spec": {"type": "object"},
              "results": {"type": "array", "items": {"type": "object"}},
              "artifact_root": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"kind": {"enum": ["reviewer_preflight", "reviewer", "doc_review"]}}},
      "then": {"properties": {"producer": {"properties": {"role": {"const": "reviewer"}}}}}
    },
    {
      "if": {"properties": {"kind": {"const": "tester"}}},
      "then": {
        "properties": {
          "details": {
            "type": "object",
            "additionalProperties": false,
            "required": ["result", "source_head", "files"],
            "properties": {
              "observations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/localObservation"}},
              "result": {"enum": ["tests_ready", "fail"]},
              "source_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
              "files": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["path", "blob"],
                  "properties": {
                    "path": {"type": "string", "minLength": 1},
                    "blob": {
                      "oneOf": [
                        {
                          "type": "string",
                          "pattern": "^[0-9a-f]{40}$"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "operation": {
                      "const": "delete"
                    },
                    "base_blob": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{40}$"
                    },
                    "base_mode": {
                      "enum": [
                        "100644",
                        "100755"
                      ]
                    }
                  },
                  "allOf": [
                    {
                      "if": {
                        "properties": {
                          "blob": {
                            "type": "null"
                          }
                        }
                      },
                      "then": {
                        "required": [
                          "operation",
                          "base_blob",
                          "base_mode"
                        ]
                      },
                      "else": {
                        "not": {
                          "anyOf": [
                            {
                              "required": [
                                "operation"
                              ]
                            },
                            {
                              "required": [
                                "base_blob"
                              ]
                            },
                            {
                              "required": [
                                "base_mode"
                              ]
                            }
                          ]
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"kind": {"const": "blackbox"}}},
      "then": {
        "properties": {
          "details": {
            "type": "object",
            "additionalProperties": false,
            "required": ["result", "worktree", "before_head", "after_head", "executions"],
            "properties": {
              "result": {"enum": ["pass", "fail"]},
              "worktree": {"type": "string", "minLength": 1},
              "before_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
              "after_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
              "executions": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["id", "argv", "returncode", "timed_out"],
                  "properties": {
                    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
                    "argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
                    "returncode": {"type": "integer"},
                    "timed_out": {"type": "boolean"}
                  }
                }
              },
              "cases": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "https://openai.local/codex-builder-loop/blackbox-case.schema.json#/$defs/boundCaseResult"
                }
              },
              "deployment": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "target_id", "artifact_sha256", "baseline_state_digest",
                  "deployed_state_digest", "restored_state_digest"
                ],
                "properties": {
                  "target_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
                  "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                  "baseline_state_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                  "deployed_state_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                  "restored_state_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                  "deploy_action": {"enum": ["executed", "skipped_existing"]},
                  "environment_disposition": {"enum": ["restored", "leased"]},
                  "lease_id": {
                    "oneOf": [
                      {"type": "null"},
                      {"type": "string", "pattern": "^[0-9a-f]{64}$"}
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"kind": {"enum": ["reviewer_preflight", "reviewer", "doc_review"]}}},
      "then": {
        "properties": {
          "details": {
            "type": "object",
            "additionalProperties": false,
            "required": ["result", "reviewed_head"],
            "properties": {
              "result": {"enum": ["pass", "findings", "blocked"]},
              "reviewed_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
              "inherited_problem_resolutions": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["obligation_id", "evidence_digest", "accepted", "rationale"], "properties": {"obligation_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "evidence_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "accepted": {"const": true}, "rationale": {"type": "string", "minLength": 1}}}},
              "observation_dispositions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/observationDisposition"}}
            }
          }
        }
      }
    }
  ]
}
