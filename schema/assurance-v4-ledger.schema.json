{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openai.local/codex-builder-loop/assurance-v4-ledger.schema.json",
  "title": "Builder Assurance Ledger v4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "runtime_identity", "run_id", "owner_session_id", "phase", "repo_root",
    "target_branch", "target_start_head", "candidate_branch", "candidate_worktree",
    "facets", "digests", "evidence", "retired_tester_sources", "finalize_intent", "final_head",
    "created_at", "updated_at", "events"
  ],
  "properties": {
    "schema_version": {"const": 4},
    "runtime_identity": {"$ref": "#/$defs/runtimeIdentity"},
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
    "owner_session_id": {"type": "string", "minLength": 1},
    "phase": {"enum": ["active", "finalizing", "finalized", "failed", "abandoned", "superseded"]},
    "repo_root": {"type": "string", "minLength": 1},
    "target_branch": {"type": "string", "minLength": 1},
    "target_start_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "candidate_branch": {"type": "string", "minLength": 1},
    "candidate_worktree": {"type": "string", "minLength": 1},
    "facets": {"$ref": "assurance-v4-contract.schema.json"},
    "digests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mission", "authority", "assurance", "execution"],
      "properties": {
        "mission": {"$ref": "#/$defs/sha256"},
        "authority": {"$ref": "#/$defs/sha256"},
        "assurance": {"$ref": "#/$defs/sha256"},
        "execution": {"$ref": "#/$defs/sha256"}
      }
    },
    "evidence": {
      "type": "object",
      "propertyNames": {"enum": ["preflight", "machine", "tester", "proof", "blackbox", "reviewer_preflight", "reviewer", "doc_review"]},
      "additionalProperties": {"$ref": "#/$defs/evidence"}
    },
    "retired_tester_sources": {
      "type": "array",
      "items": {"$ref": "assurance-v4-contract.schema.json#/$defs/testerSource"}
    },
    "retired_reviewer_agents": {"type": "array", "items": {"$ref": "assurance-v4-contract.schema.json#/$defs/agent"}},
    "driver_runtime": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/driverRuntime"}
      ]
    },
    "driver_failure": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/driverFailure"}
      ]
    },
    "dispatch_intent": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/dispatchIntent"}
      ]
    },
    "proof_failure": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/proofFailure"}
      ]
    },
    "machine_failure": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/machineFailure"}
      ]
    },
    "recomposition_intent": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/recompositionIntent"}
      ]
    },
    "deployment_transaction": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/deploymentTransaction"}
      ]
    },
    "pending_blackbox": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/pendingBlackbox"}
      ]
    },
    "environment_lease": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/environmentLease"}
      ]
    },
    "supersede_intent": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["source_run_id", "target_run_id", "state"],
          "properties": {
            "source_run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
            "target_run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
            "state": {"enum": ["prepared", "artifact_mismatch", "received"]}
          }
        }
      ]
    },
    "abandon_intent": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["reason"],
          "properties": {"reason": {"type": "string", "minLength": 1}}
        }
      ]
    },
    "problems": {"type": "array", "items": {"$ref": "#/$defs/problem"}},
    "revision_transitions": {"type": "array", "items": {"$ref": "assurance-v4-lineage.schema.json#/$defs/recordedTransition"}},
    "problem_dispositions": {"type": "array", "items": {"$ref": "#/$defs/problemDisposition"}},
    "publication": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/publication"}]},
    "builder_checkpointed": {"type": "boolean"},
    "continuation_consumed_by": {"oneOf": [{"type": "string"}, {"type": "null"}]},
    "continuation_consume_intent": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["business_run_id", "target_head", "contract_digest"],
          "properties": {
            "business_run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
            "target_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
            "contract_digest": {"$ref": "#/$defs/sha256"}
          }
        }
      ]
    },
    "finalize_intent": {"oneOf": [{"$ref": "#/$defs/finalizeIntent"}, {"type": "null"}]},
    "final_head": {"oneOf": [{"type": "string", "pattern": "^[0-9a-f]{40}$"}, {"type": "null"}]},
    "created_at": {"type": "string", "minLength": 1},
    "updated_at": {"type": "string", "minLength": 1},
    "events": {"type": "array", "items": {"type": "object"}}
  },
  "$defs": {
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "nullableCommit": {
      "oneOf": [{"$ref": "#/$defs/commit"}, {"type": "null"}]
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "runtimeIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter", "adapter_commit", "adapter_dirty", "capture_status"],
      "properties": {
        "adapter": {"enum": ["codex", "claude-code", "unknown"]},
        "adapter_commit": {"$ref": "#/$defs/nullableCommit"},
        "adapter_dirty": {
          "oneOf": [{"type": "boolean"}, {"type": "null"}]
        },
        "capture_status": {
          "enum": ["captured", "partial", "unavailable", "legacy-unavailable"]
        }
      }
    },
    "driverRuntime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "protocol_version", "transport", "runtime_version", "protocol_schema_digest"],
      "properties": {
        "kind": {"enum": ["native", "full_driver_skill"]},
        "protocol_version": {"const": 1},
        "transport": {"enum": ["codex_app_server", "native_tools"]},
        "runtime_version": {"type": "string", "minLength": 1},
        "protocol_schema_digest": {"$ref": "#/$defs/sha256"}
      }
    },
    "driverFailureAction": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["action_id", "action", "reason"],
          "properties": {
            "action_id": {"$ref": "#/$defs/sha256"},
            "action": {"type": "string", "minLength": 1},
            "reason": {"type": "string", "minLength": 1}
          }
        }
      ]
    },
    "driverFailureDispatch": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["action_id", "action", "role", "thread_id", "state", "attempt"],
          "properties": {
            "action_id": {"$ref": "#/$defs/sha256"},
            "action": {"type": "string", "minLength": 1},
            "role": {"enum": ["builder", "tester", "reviewer"]},
            "thread_id": {"type": "string", "minLength": 1},
            "state": {"enum": ["prepared", "in_flight", "completed"]},
            "attempt": {"type": "integer", "minimum": 1, "maximum": 3},
            "turn_id": {"type": "string", "minLength": 1}
          }
        }
      ]
    },
    "driverFailureObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ledger_phase", "ledger_candidate_head", "target_head", "candidate_branch",
        "candidate_branch_head", "candidate_worktree", "candidate_worktree_exists",
        "candidate_worktree_head", "candidate_dirty_paths"
      ],
      "properties": {
        "ledger_phase": {"enum": ["active", "finalizing", "finalized", "failed", "abandoned", "superseded"]},
        "ledger_candidate_head": {"$ref": "#/$defs/nullableCommit"},
        "target_head": {"$ref": "#/$defs/nullableCommit"},
        "candidate_branch": {"type": "string", "minLength": 1},
        "candidate_branch_head": {"$ref": "#/$defs/nullableCommit"},
        "candidate_worktree": {"type": "string", "minLength": 1},
        "candidate_worktree_exists": {"type": "boolean"},
        "candidate_worktree_head": {"$ref": "#/$defs/nullableCommit"},
        "candidate_dirty_paths": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "driverFailure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source", "status", "code", "message", "details", "action", "dispatch",
        "observation", "signature", "digest", "recovery", "state", "recorded_at"
      ],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "status": {"const": "FATAL"},
        "code": {"type": "string", "minLength": 1},
        "message": {"type": "string", "minLength": 1},
        "details": {},
        "action": {"$ref": "#/$defs/driverFailureAction"},
        "dispatch": {"$ref": "#/$defs/driverFailureDispatch"},
        "observation": {"$ref": "#/$defs/driverFailureObservation"},
        "signature": {"$ref": "#/$defs/sha256"},
        "digest": {"$ref": "#/$defs/sha256"},
        "recovery": {"enum": ["none", "finalize", "deployment"]},
        "state": {"enum": ["recorded", "recovering", "recovered", "terminal"]},
        "recorded_at": {"type": "string", "minLength": 1},
        "recovery_started_at": {"type": "string", "minLength": 1},
        "recovered_at": {"type": "string", "minLength": 1},
        "terminal_at": {"type": "string", "minLength": 1}
      }
    },
    "dispatchIntent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_id", "action", "role", "thread_id", "prompt_digest",
        "output_schema_digest", "state", "created_at"
      ],
      "properties": {
        "action_id": {"$ref": "#/$defs/sha256"},
        "action": {"type": "string", "minLength": 1},
        "role": {"enum": ["builder", "tester", "reviewer"]},
        "thread_id": {"type": "string", "minLength": 1},
        "prompt_digest": {"$ref": "#/$defs/sha256"},
        "output_schema_digest": {"$ref": "#/$defs/sha256"},
        "state": {"enum": ["prepared", "in_flight", "completed"]},
        "attempt": {"type": "integer", "minimum": 1, "maximum": 3},
        "turn_id": {"type": "string", "minLength": 1},
        "result_path": {"type": "string", "minLength": 1},
        "result_digest": {"$ref": "#/$defs/sha256"},
        "created_at": {"type": "string", "minLength": 1},
        "completed_at": {"type": "string", "minLength": 1}
      }
    },
    "proofFailure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_id", "candidate_head", "tester_source_head", "producer",
        "spec", "spec_digest", "dependency_digest", "failure", "recovery",
        "failure_signature", "failure_digest", "artifact_root", "recorded_at"
      ],
      "properties": {
        "action_id": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/sha256"}
          ]
        },
        "candidate_head": {"$ref": "#/$defs/nullableCommit"},
        "tester_source_head": {"$ref": "#/$defs/nullableCommit"},
        "producer": {
          "type": "object",
          "additionalProperties": false,
          "required": ["role", "agent_id", "thread_id"],
          "properties": {
            "role": {"const": "tester"},
            "agent_id": {"type": "string", "minLength": 1},
            "thread_id": {"type": "string", "minLength": 1}
          }
        },
        "spec": {
          "$ref": "https://github.com/catchmeee2002/cc-builder-loop/schema/codex-test-proof.schema.json"
        },
        "spec_digest": {"$ref": "#/$defs/sha256"},
        "dependency_digest": {"$ref": "#/$defs/sha256"},
        "failure": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "code", "message", "details"],
          "properties": {
            "status": {"type": "string", "minLength": 1},
            "code": {"type": "string", "minLength": 1},
            "message": {"type": "string", "minLength": 1},
            "details": {"type": "object"}
          }
        },
        "recovery": {"enum": ["tester_diagnosis", "needs_user"]},
        "failure_signature": {"$ref": "#/$defs/sha256"},
        "failure_digest": {"$ref": "#/$defs/sha256"},
        "artifact_root": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "minLength": 1}
          ]
        },
        "recorded_at": {"type": "string", "minLength": 1}
      }
    },
    "machineFailure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_id", "stage", "candidate_head", "tester_source_head",
        "dependency_digest", "commands", "recovery", "failure_signature",
        "failure_digest", "recorded_at"
      ],
      "properties": {
        "action_id": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/sha256"}
          ]
        },
        "stage": {"enum": ["preflight", "machine"]},
        "candidate_head": {"$ref": "#/$defs/nullableCommit"},
        "tester_source_head": {"$ref": "#/$defs/nullableCommit"},
        "dependency_digest": {"$ref": "#/$defs/sha256"},
        "commands": {"type": "array", "minItems": 1, "items": {"type": "object"}},
        "recovery": {"enum": ["tester_diagnosis", "needs_user"]},
        "failure_signature": {"$ref": "#/$defs/sha256"},
        "failure_digest": {"$ref": "#/$defs/sha256"},
        "recorded_at": {"type": "string", "minLength": 1}
      }
    },
    "recompositionIntent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intent_id", "kind", "state", "old_target_head", "new_target_head",
        "old_candidate_head", "incoming_candidate_head", "publication_generation",
        "staging_root", "target_restart_count", "created_at", "updated_at"
      ],
      "properties": {
        "intent_id": {"$ref": "#/$defs/sha256"},
        "kind": {"enum": ["publication_refresh", "target_rematerialization"]},
        "state": {
          "enum": [
            "prepared", "builder_staging", "waiting_builder", "publication_staging",
            "tester_staging", "waiting_tester", "candidate_staging", "committing"
          ]
        },
        "old_target_head": {"$ref": "#/$defs/commit"},
        "new_target_head": {"$ref": "#/$defs/commit"},
        "old_candidate_head": {"$ref": "#/$defs/commit"},
        "incoming_candidate_head": {"$ref": "#/$defs/commit"},
        "source_builder_base": {"$ref": "#/$defs/commit"},
        "source_builder_head": {"$ref": "#/$defs/commit"},
        "source_tester_base": {"$ref": "#/$defs/commit"},
        "source_tester_head": {"$ref": "#/$defs/commit"},
        "publication_generation": {"type": "integer", "minimum": 0},
        "staging_root": {"type": "string", "minLength": 1},
        "builder_branch": {"type": "string", "minLength": 1},
        "builder_worktree": {"type": "string", "minLength": 1},
        "builder_head": {"$ref": "#/$defs/commit"},
        "publication_head": {"$ref": "#/$defs/commit"},
        "publication_tree": {"$ref": "#/$defs/commit"},
        "publication_files": {"type": "array", "items": {"$ref": "#/$defs/publicationFile"}},
        "tester_branch": {"type": "string", "minLength": 1},
        "tester_worktree": {"type": "string", "minLength": 1},
        "tester_head": {"$ref": "#/$defs/commit"},
        "candidate_head": {"$ref": "#/$defs/commit"},
        "conflict_paths": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "conflict_owner": {"enum": ["builder", "tester"]},
        "target_restart_count": {"type": "integer", "minimum": 0, "maximum": 3},
        "created_at": {"type": "string", "minLength": 1},
        "updated_at": {"type": "string", "minLength": 1}
      }
    },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "target_id", "state_digest", "deployed_artifact_sha256"],
      "properties": {
        "schema_version": {"const": 1},
        "target_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "state_digest": {"$ref": "#/$defs/sha256"},
        "deployed_artifact_sha256": {
          "oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]
        }
      }
    },
    "deploymentTransaction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transaction_id", "state", "candidate_head", "target_id", "worktree",
        "artifact_path", "artifact_sha256", "baseline_probe", "deployed_probe",
        "restored_probe", "failure_code"
      ],
      "properties": {
        "transaction_id": {"$ref": "#/$defs/sha256"},
        "state": {"enum": ["preparing", "deploying", "deployed", "restore_required", "restoring", "restored", "restore_failed"]},
        "candidate_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "target_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "worktree": {"type": "string", "minLength": 1},
        "artifact_path": {"type": "string", "minLength": 1},
        "artifact_sha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
        "baseline_probe": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/probe"}]},
        "deployed_probe": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/probe"}]},
        "restored_probe": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/probe"}]},
        "deploy_action": {
          "oneOf": [
            {"type": "null"},
            {"enum": ["executed", "skipped_existing"]}
          ]
        },
        "restore_required_after_reuse": {"type": "boolean"},
        "failure_code": {"oneOf": [{"type": "null"}, {"type": "string", "minLength": 1}]}
      }
    },
    "environmentLease": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lease_id", "state", "owner_run_id", "target_id", "artifact_sha256",
        "deployment_digest", "baseline_probe", "active_probe", "mission_revision"
      ],
      "properties": {
        "lease_id": {"$ref": "#/$defs/sha256"},
        "state": {"enum": ["held", "transfer_prepared", "transferred", "restore_required", "restoring", "released", "restore_failed"]},
        "owner_run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
        "target_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "artifact_sha256": {"$ref": "#/$defs/sha256"},
        "deployment_digest": {"$ref": "#/$defs/sha256"},
        "baseline_probe": {"$ref": "#/$defs/probe"},
        "active_probe": {"$ref": "#/$defs/probe"},
        "mission_revision": {"type": "integer", "minimum": 1},
        "transferred_to_run_id": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"}
          ]
        }
      }
    },
    "pendingBlackbox": {
      "type": "object",
      "additionalProperties": false,
      "required": ["report", "report_digest", "candidate_head"],
      "properties": {
        "report": {"type": "object"},
        "report_digest": {"$ref": "#/$defs/sha256"},
        "candidate_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "publicationFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "blob"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "blob": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "paths", "head", "tree", "files", "manifest_digest"],
      "properties": {
        "required": {"type": "boolean"},
        "generation": {"type": "integer", "minimum": 0},
        "paths": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "head": {"oneOf": [{"type": "null"}, {"type": "string", "pattern": "^[0-9a-f]{40}$"}]},
        "tree": {"oneOf": [{"type": "null"}, {"type": "string", "pattern": "^[0-9a-f]{40}$"}]},
        "files": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/publicationFile"}},
        "manifest_digest": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
        "candidate_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "problem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "summary", "details", "owner", "status", "producer", "candidate_head", "recorded_at"],
      "properties": {
        "key": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1},
        "details": {"type": "string", "minLength": 1},
        "owner": {"enum": ["builder", "tester", "plan", "current_project", "builder_loop", "external_platform"]},
        "decision_request": {
          "$ref": "https://openai.local/codex-builder-loop/problem-report-v1.schema.json#/$defs/decisionRequest"
        },
        "status": {"enum": ["open", "resolved"]},
        "producer": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["role", "agent_id", "thread_id"],
              "properties": {
                "role": {"enum": ["builder", "tester", "reviewer"]},
                "agent_id": {"type": "string", "minLength": 1},
                "thread_id": {"type": "string", "minLength": 1}
              }
            }
          ]
        },
        "candidate_head": {"oneOf": [{"type": "null"}, {"type": "string", "pattern": "^[0-9a-f]{40}$"}]},
        "recorded_at": {"type": "string", "minLength": 1},
        "resolution": {"type": "string", "minLength": 1},
        "resolved_at": {"type": "string", "minLength": 1}
      }
    },
    "problemDisposition": {
      "type": "object", "additionalProperties": false,
      "required": ["source_run_id", "target_run_id", "key", "disposition"],
      "properties": {
        "source_run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
        "target_run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
        "key": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "disposition": {"enum": ["included", "handled_elsewhere", "discarded"]},
        "reference": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "finalizeIntent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expected_target_head", "candidate_head", "final_head", "changed_files"],
      "properties": {
        "expected_target_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "candidate_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "final_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "changed_files": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "status", "dependency_digest", "candidate_head", "producer", "details", "recorded_at"],
      "properties": {
        "kind": {"enum": ["preflight", "machine", "tester", "proof", "blackbox", "reviewer_preflight", "reviewer", "doc_review"]},
        "status": {"enum": ["pass", "fail"]},
        "dependency_digest": {"$ref": "#/$defs/sha256"},
        "candidate_head": {"oneOf": [{"type": "string", "pattern": "^[0-9a-f]{40}$"}, {"type": "null"}]},
        "producer": {
          "type": "object",
          "additionalProperties": false,
          "required": ["role", "agent_id", "thread_id"],
          "properties": {
            "role": {"enum": ["runtime", "tester", "reviewer"]},
            "agent_id": {"type": "string", "minLength": 1},
            "thread_id": {"type": "string", "minLength": 1}
          }
        },
        "details": {"type": "object"},
        "recorded_at": {"type": "string", "minLength": 1}
      }
    }
  }
}
