{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "builder-loop/agent-result@1",
  "title": "builder-loop agent result",
  "description": "tester / reviewer 交卷报告最后一行的 `BUILDER_LOOP_RESULT: {...}`：有 SubagentHandback 时由 PostToolUse(SubagentHandback) hook 从 handback message 解析，没有时由 SubagentStop hook 从 last_assistant_message 解析。",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "role",
        "status"
      ],
      "properties": {
        "role": {
          "const": "tester"
        },
        "status": {
          "enum": [
            "pass",
            "insufficient_spec"
          ]
        },
        "behaviors_covered": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "proof_spec": {
          "$ref": "proof-spec.schema.json"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    {
      "type": "object",
      "required": [
        "role",
        "verdict"
      ],
      "properties": {
        "role": {
          "const": "reviewer"
        },
        "verdict": {
          "enum": [
            "pass",
            "changes_requested",
            "blocked"
          ]
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "severity"
            ],
            "properties": {
              "severity": {
                "enum": [
                  "blocking",
                  "major",
                  "minor"
                ]
              },
              "file": {
                "type": "string"
              },
              "line": {
                "type": "integer"
              },
              "summary": {
                "type": "string"
              },
              "owner": {
                "enum": [
                  "builder",
                  "tester",
                  "contract"
                ],
                "description": "blocking / major 必填：runtime 据此路由（测试问题回 tester，需改契约的交还用户）"
              }
            }
          }
        },
        "behaviors_verified": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  ]
}
