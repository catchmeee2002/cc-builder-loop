{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openai.local/codex-builder-loop/blackbox-report-v2.schema.json",
  "title": "Codex Builder Loop Blackbox Report v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "candidate_worktree",
    "head_before",
    "head_after",
    "candidate_dirty",
    "executions"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "candidate_worktree": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "head_before": {"$ref": "#/$defs/commit"},
    "head_after": {"$ref": "#/$defs/commit"},
    "candidate_dirty": {"const": false},
    "normal_residue": {
      "type": "array",
      "maxItems": 0,
      "items": {"type": "string"}
    },
    "ignored_residue": {
      "type": "array",
      "maxItems": 0,
      "items": {"type": "string"}
    },
    "executions": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/execution"}
    },
    "cases": {
      "type": "array",
      "items": {
        "$ref": "https://openai.local/codex-builder-loop/blackbox-case.schema.json#/$defs/legacyCaseResult"
      }
    }
  },
  "$defs": {
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "execution": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["method", "command", "returncode", "timed_out"],
          "properties": {
            "method": {"const": "command"},
            "command": {"type": "string", "minLength": 1, "pattern": "\\S"},
            "returncode": {"type": "integer"},
            "duration_ms": {"type": "integer", "minimum": 0},
            "timed_out": {"type": "boolean"},
            "log_sha256": {"$ref": "#/$defs/sha256"}
          },
          "not": {"required": ["reason"]}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["method", "reason"],
          "properties": {
            "method": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S",
              "not": {"const": "command"}
            },
            "reason": {"type": "string", "minLength": 1, "pattern": "\\S"},
            "duration_ms": {"type": "integer", "minimum": 0},
            "log_sha256": {"$ref": "#/$defs/sha256"}
          },
          "not": {"anyOf": [{"required": ["command"]}, {"required": ["returncode"]}]}
        }
      ]
    }
  }
}
