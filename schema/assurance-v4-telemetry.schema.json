{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openai.local/codex-builder-loop/assurance-v4-telemetry.schema.json",
  "title": "Builder Assurance Telemetry v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "elapsed_ms", "active_stage", "stages",
    "candidate_changes", "evidence_attempts", "evidence_replays", "retries",
    "profile", "duration_breakdown"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requested", "effective", "escalation_reason"],
      "properties": {
        "requested": {"enum": ["full", "compact"]},
        "effective": {"enum": ["full", "compact"]},
        "escalation_reason": {
          "oneOf": [{"type": "null"}, {"type": "string", "minLength": 1}]
        }
      }
    },
    "duration_breakdown": {
      "type": "object",
      "additionalProperties": false,
      "required": ["implementation_ms", "verification_ms", "orchestration_ms", "waiting_ms"],
      "properties": {
        "implementation_ms": {"type": "integer", "minimum": 0},
        "verification_ms": {"type": "integer", "minimum": 0},
        "orchestration_ms": {"type": "integer", "minimum": 0},
        "waiting_ms": {"type": "integer", "minimum": 0}
      }
    },
    "elapsed_ms": {"type": "integer", "minimum": 0},
    "wire_observation_checkpoints": {"type": "integer", "minimum": 0},
    "transport_cleanup_unknown": {"type": "integer", "minimum": 0},
    "deferred_wait_stalls": {"type": "integer", "minimum": 0},
    "active_stage": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "minLength": 1}
      ]
    },
    "stages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name", "attempts", "completed_attempts", "failed_attempts",
          "retry_count", "total_duration_ms", "last_failure_code"
        ],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "attempts": {"type": "integer", "minimum": 0},
          "completed_attempts": {"type": "integer", "minimum": 0},
          "failed_attempts": {"type": "integer", "minimum": 0},
          "retry_count": {"type": "integer", "minimum": 0},
          "total_duration_ms": {"type": "integer", "minimum": 0},
          "last_failure_code": {
            "oneOf": [
              {"type": "null"},
              {"type": "string", "minLength": 1}
            ]
          }
        }
      }
    },
    "candidate_changes": {"type": "integer", "minimum": 0},
    "evidence_attempts": {
      "type": "object",
      "propertyNames": {
        "enum": ["preflight", "machine", "tester", "proof", "blackbox", "reviewer_preflight", "reviewer", "doc_review"]
      },
      "additionalProperties": {"type": "integer", "minimum": 0}
    },
    "evidence_replays": {"type": "integer", "minimum": 0},
    "retries": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "by_failure_code"],
      "properties": {
        "total": {"type": "integer", "minimum": 0},
        "by_failure_code": {
          "type": "object",
          "additionalProperties": {"type": "integer", "minimum": 1}
        }
      }
    },
    "time_classes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent_turn_ms", "deterministic_gate_ms", "recomposition_ms", "idle_or_user_wait_ms"],
      "properties": {
        "agent_turn_ms": {"type": "integer", "minimum": 0},
        "deterministic_gate_ms": {"type": "integer", "minimum": 0},
        "recomposition_ms": {"type": "integer", "minimum": 0},
        "idle_or_user_wait_ms": {"type": "integer", "minimum": 0}
      }
    },
    "primary_delays": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stage", "duration_ms", "attempts", "last_failure_code"],
        "properties": {
          "stage": {"type": "string", "minLength": 1},
          "duration_ms": {"type": "integer", "minimum": 0},
          "attempts": {"type": "integer", "minimum": 0},
          "last_failure_code": {
            "oneOf": [{"type": "null"}, {"type": "string", "minLength": 1}]
          }
        }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "publication_generations", "target_drifts", "recomposition_attempts",
        "recomposition_restarts", "builder_conflict_repairs", "tester_conflict_repairs",
        "reviewer_preflight_attempts", "reviewer_thread_compactions"
      ],
      "properties": {
        "publication_generations": {"type": "integer", "minimum": 0},
        "target_drifts": {"type": "integer", "minimum": 0},
        "recomposition_attempts": {"type": "integer", "minimum": 0},
        "recomposition_restarts": {"type": "integer", "minimum": 0},
        "builder_conflict_repairs": {"type": "integer", "minimum": 0},
        "tester_conflict_repairs": {"type": "integer", "minimum": 0},
        "reviewer_preflight_attempts": {"type": "integer", "minimum": 0},
        "dispatch_renewals": {"type": "integer", "minimum": 0},
        "reviewer_thread_compactions": {"type": "integer", "minimum": 0}
      }
    },
    "expected_stages": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "warnings": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
