{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openai.local/codex-builder-loop/assurance-v4-contract.schema.json",
  "title": "Builder Assurance Contract v4",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "mission", "authority", "assurance", "execution"],
  "properties": {
    "schema_version": {"const": 4},
    "mission": {"$ref": "#/$defs/mission"},
    "authority": {"$ref": "#/$defs/authority"},
    "assurance": {"$ref": "#/$defs/assurance"},
    "execution": {"$ref": "#/$defs/execution"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
    "statement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "description": {"type": "string", "minLength": 1}
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surface_id", "surface_description", "execution_ids", "required_dimensions"],
      "properties": {
        "surface_id": {"$ref": "#/$defs/id"},
        "surface_description": {"type": "string", "minLength": 1},
        "execution_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/id"}
        },
        "required_dimensions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["mechanical", "verify", "quality"]}
        },
        "target_id": {"$ref": "#/$defs/id"}
      }
    },
    "acceptanceCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "description": {"type": "string", "minLength": 1},
        "observation": {"$ref": "#/$defs/observation"}
      }
    },
    "mission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "objective", "behaviors", "interfaces", "acceptance_cases", "trust_boundaries"],
      "properties": {
        "delivery_kind": {"enum": ["code", "documentation", "preparation"]},
        "revision": {"type": "integer", "minimum": 1},
        "supersedes": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["run_id", "revision", "mission_digest", "candidate_head"],
              "properties": {
                "run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
                "revision": {"type": "integer", "minimum": 1},
                "mission_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "candidate_head": {"$ref": "#/$defs/commit"}
              }
            }
          ]
        },
        "objective": {"type": "string", "minLength": 1},
        "behaviors": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/statement"}},
        "interfaces": {"type": "array", "items": {"$ref": "#/$defs/statement"}},
        "acceptance_cases": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/acceptanceCase"}},
        "trust_boundaries": {"type": "array", "items": {"$ref": "#/$defs/statement"}}
      }
    },
    "dirtyIntake": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/path"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_branch", "builder_write", "tester_write", "dirty_intake"],
      "properties": {
        "target_branch": {"type": "string", "minLength": 1},
        "builder_write": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/path"}},
        "tester_write": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/path"}},
        "dirty_intake": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/dirtyIntake"}},
        "public_prerequisites": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/path"}},
        "protected_support_paths": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/path"}},
        "external_targets": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/externalTarget"}}
      }
    },
    "externalTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "description": {"type": "string", "minLength": 1}
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "argv", "timeout_seconds"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 7200},
        "expected_returncodes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer"}},
        "run_before_full_suite": {"type": "boolean"}
      }
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_id", "artifact_path", "build_command", "deploy_command",
        "probe_command", "restore_command"
      ],
      "properties": {
        "target_id": {"$ref": "#/$defs/id"},
        "artifact_path": {"$ref": "#/$defs/path"},
        "build_command": {"$ref": "#/$defs/command"},
        "deploy_command": {"$ref": "#/$defs/command"},
        "probe_command": {"$ref": "#/$defs/command"},
        "restore_command": {"$ref": "#/$defs/command"}
        ,"revision_retention": {"enum": ["restore", "lease"]}
      }
    },
    "assurance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "machine_commands"],
      "properties": {
        "profile": {"enum": ["full", "compact"]},
        "required": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["machine", "tester", "proof", "blackbox", "reviewer", "doc_review"]}
        },
        "machine_commands": {"type": "array", "items": {"$ref": "#/$defs/command"}},
        "preflight_before_proof": {"type": "boolean"},
        "reviewer_preflight": {"type": "boolean"}
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent_id", "thread_id"],
      "properties": {
        "agent_id": {"type": "string", "minLength": 1},
        "thread_id": {"type": "string", "minLength": 1}
      }
    },
    "builderRuntime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "mode"],
      "properties": {
        "schema_version": {"const": 1},
        "mode": {"enum": ["root_session", "native_thread"]}
      }
    },
    "builderOwner": {
      "oneOf": [
        {"$ref": "#/$defs/agent"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "agent_id", "thread_id"],
          "properties": {
            "mode": {"const": "native_thread"},
            "agent_id": {"type": "string", "minLength": 1},
            "thread_id": {"type": "string", "minLength": 1}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "agent_id", "session_id"],
          "properties": {
            "mode": {"const": "root_session"},
            "agent_id": {"type": "string", "minLength": 1},
            "session_id": {"type": "string", "minLength": 1}
          }
        }
      ]
    },
    "testerSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["head", "branch", "worktree", "files", "replaces_files", "agent"],
      "properties": {
        "base_head": {"$ref": "#/$defs/commit"},
        "head": {"$ref": "#/$defs/commit"},
        "branch": {"type": "string", "minLength": 1},
        "worktree": {"type": "string", "minLength": 1},
        "files": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "blob"],
            "properties": {
              "path": {"$ref": "#/$defs/path"},
              "blob": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
            }
          }
        },
        "replaces_files": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "blob"],
            "properties": {
              "path": {"$ref": "#/$defs/path"},
              "blob": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
            }
          }
        },
        "agent": {"$ref": "#/$defs/agent"}
      }
    },
    "continuation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preparation_run_id", "preparation_final_head", "support_paths"],
      "properties": {
        "preparation_run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
        "preparation_final_head": {"$ref": "#/$defs/commit"},
        "support_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/path"}}
      }
    },
    "recoveryPolicy": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema_version", "mode"],
          "properties": {
            "schema_version": {"const": 1},
            "mode": {"const": "manual"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema_version", "mode", "continuation_window"],
          "properties": {
            "schema_version": {"const": 1},
            "mode": {"const": "automatic_nonsemantic"},
            "continuation_window": {"const": 3}
          }
        }
      ]
    },
    "progressPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "mode",
        "attempt_limit",
        "rehydration_limit",
        "max_units_per_thread",
        "context_source"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "mode": {"const": "bounded_rehydration"},
        "attempt_limit": {"const": 3},
        "rehydration_limit": {"const": 1},
        "max_units_per_thread": {"const": 3},
        "context_source": {"const": "canonical"}
      }
    },
    "workUnitScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["paths", "behavior_ids", "command_ids"],
      "properties": {
        "paths": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/path"}
        },
        "behavior_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/id"}
        },
        "command_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/id"}
        }
      }
    },
    "workUnitCompletion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "required_observations"],
      "properties": {
        "kind": {
          "enum": ["candidate_checkpoint", "tester_source", "review_evidence"]
        },
        "required_observations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "candidate_commit",
              "tester_source_commit",
              "review_report"
            ]
          }
        }
      }
    },
    "workUnit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "role",
        "objective",
        "depends_on",
        "scope",
        "completion"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "role": {"enum": ["builder", "tester", "reviewer"]},
        "objective": {"type": "string", "minLength": 1},
        "depends_on": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/id"}
        },
        "scope": {"$ref": "#/$defs/workUnitScope"},
        "completion": {"$ref": "#/$defs/workUnitCompletion"}
      }
    },
    "costAncestry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_run_id", "source_lineage_digest", "source_task_pressure_digest"],
      "properties": {
        "source_run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
        "source_lineage_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "source_task_pressure_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "candidate_head", "builder_files", "tester_files", "tester_source", "dirty_snapshot", "commands", "agents"],
      "properties": {
        "version": {"type": "integer", "minimum": 1},
        "candidate_head": {"oneOf": [{"$ref": "#/$defs/commit"}, {"type": "null"}]},
        "builder_files": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/path"}},
        "tester_files": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/path"}},
        "builder_runtime": {"$ref": "#/$defs/builderRuntime"},
        "tester_source": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/testerSource"}
          ]
        },
        "driver_enforced": {"type": "boolean"},
        "recovery_policy": {"$ref": "#/$defs/recoveryPolicy"},
        "progress_policy": {"$ref": "#/$defs/progressPolicy"},
        "work_units": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/workUnit"}
        },
        "cost_ancestry": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/costAncestry"}
          ]
        },
        "continuation": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/continuation"}]},
        "carryover": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["source_run_id", "source_candidate_head", "files"],
              "properties": {
                "source_run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
                "source_candidate_head": {"$ref": "#/$defs/commit"},
                "files": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["path", "blob"],
                    "properties": {
                      "path": {"$ref": "#/$defs/path"},
                      "blob": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
                    }
                  }
                }
              }
            }
          ]
        },
        "revision_transition": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "assurance-v4-lineage.schema.json#/$defs/transitionInput"}
          ]
        },
        "prior_problem_dispositions": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["source_snapshot_digest", "items"],
              "properties": {
                "source_snapshot_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "items": {
                  "type": "array", "uniqueItems": true,
                  "items": {
                    "type": "object", "additionalProperties": false,
                    "required": ["key", "disposition"],
                    "properties": {
                      "key": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
                      "disposition": {"enum": ["included", "handled_elsewhere", "discarded"]}
                    }
                  }
                }
              }
            }
          ]
        },
        "prior_problems": {"type": "null"},
        "deployment": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/deployment"}]},
        "dirty_snapshot": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256", "blob"],
            "properties": {
              "path": {"$ref": "#/$defs/path"},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "blob": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
            }
          }
        },
        "commands": {"type": "array", "items": {"$ref": "#/$defs/command"}},
        "agents": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "builder": {"$ref": "#/$defs/builderOwner"},
            "tester": {"$ref": "#/$defs/agent"},
            "reviewer": {"$ref": "#/$defs/agent"}
          }
        }
      }
    }
  }
}
