{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openai.local/codex-builder-loop/assurance-v4-contract.schema.json",
  "title": "Builder Assurance Contract v4",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "mission", "authority", "assurance", "execution"],
  "properties": {
    "schema_version": {"const": 4},
    "mission": {"$ref": "#/$defs/mission"},
    "authority": {"$ref": "#/$defs/authority"},
    "assurance": {"$ref": "#/$defs/assurance"},
    "execution": {"$ref": "#/$defs/execution"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
    "statement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "description": {"type": "string", "minLength": 1}
      }
    },
    "mission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "objective", "behaviors", "interfaces", "acceptance_cases", "trust_boundaries"],
      "properties": {
        "delivery_kind": {"enum": ["code", "documentation", "preparation"]},
        "revision": {"type": "integer", "minimum": 1},
        "supersedes": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["run_id", "revision", "mission_digest", "candidate_head"],
              "properties": {
                "run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
                "revision": {"type": "integer", "minimum": 1},
                "mission_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "candidate_head": {"$ref": "#/$defs/commit"}
              }
            }
          ]
        },
        "objective": {"type": "string", "minLength": 1},
        "behaviors": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/statement"}},
        "interfaces": {"type": "array", "items": {"$ref": "#/$defs/statement"}},
        "acceptance_cases": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/statement"}},
        "trust_boundaries": {"type": "array", "items": {"$ref": "#/$defs/statement"}}
      }
    },
    "dirtyIntake": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/path"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_branch", "builder_write", "tester_write", "dirty_intake"],
      "properties": {
        "target_branch": {"type": "string", "minLength": 1},
        "builder_write": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/path"}},
        "tester_write": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/path"}},
        "dirty_intake": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/dirtyIntake"}},
        "public_prerequisites": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/path"}},
        "protected_support_paths": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/path"}},
        "external_targets": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/externalTarget"}}
      }
    },
    "externalTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "description": {"type": "string", "minLength": 1}
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "argv", "timeout_seconds"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 7200},
        "expected_returncodes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer"}},
        "run_before_full_suite": {"type": "boolean"}
      }
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_id", "artifact_path", "build_command", "deploy_command",
        "probe_command", "restore_command"
      ],
      "properties": {
        "target_id": {"$ref": "#/$defs/id"},
        "artifact_path": {"$ref": "#/$defs/path"},
        "build_command": {"$ref": "#/$defs/command"},
        "deploy_command": {"$ref": "#/$defs/command"},
        "probe_command": {"$ref": "#/$defs/command"},
        "restore_command": {"$ref": "#/$defs/command"}
        ,"revision_retention": {"enum": ["restore", "lease"]}
      }
    },
    "assurance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "machine_commands"],
      "properties": {
        "required": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["machine", "tester", "proof", "blackbox", "reviewer", "doc_review"]}
        },
        "machine_commands": {"type": "array", "items": {"$ref": "#/$defs/command"}}
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent_id", "thread_id"],
      "properties": {
        "agent_id": {"type": "string", "minLength": 1},
        "thread_id": {"type": "string", "minLength": 1}
      }
    },
    "testerSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["head", "branch", "worktree", "files", "replaces_files", "agent"],
      "properties": {
        "base_head": {"$ref": "#/$defs/commit"},
        "head": {"$ref": "#/$defs/commit"},
        "branch": {"type": "string", "minLength": 1},
        "worktree": {"type": "string", "minLength": 1},
        "files": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "blob"],
            "properties": {
              "path": {"$ref": "#/$defs/path"},
              "blob": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
            }
          }
        },
        "replaces_files": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "blob"],
            "properties": {
              "path": {"$ref": "#/$defs/path"},
              "blob": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
            }
          }
        },
        "agent": {"$ref": "#/$defs/agent"}
      }
    },
    "continuation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preparation_run_id", "preparation_final_head", "support_paths"],
      "properties": {
        "preparation_run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
        "preparation_final_head": {"$ref": "#/$defs/commit"},
        "support_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/path"}}
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "candidate_head", "builder_files", "tester_files", "tester_source", "dirty_snapshot", "commands", "agents"],
      "properties": {
        "version": {"type": "integer", "minimum": 1},
        "candidate_head": {"oneOf": [{"$ref": "#/$defs/commit"}, {"type": "null"}]},
        "builder_files": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/path"}},
        "tester_files": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/path"}},
        "tester_source": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/testerSource"}
          ]
        },
        "driver_enforced": {"type": "boolean"},
        "continuation": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/continuation"}]},
        "carryover": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["source_run_id", "source_candidate_head", "files"],
              "properties": {
                "source_run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
                "source_candidate_head": {"$ref": "#/$defs/commit"},
                "files": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["path", "blob"],
                    "properties": {
                      "path": {"$ref": "#/$defs/path"},
                      "blob": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
                    }
                  }
                }
              }
            }
          ]
        },
        "revision_transition": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "assurance-v4-lineage.schema.json#/$defs/transitionInput"}
          ]
        },
        "prior_problems": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["schema_version", "source_run_id", "snapshot_digest", "items"],
              "properties": {
                "schema_version": {"const": 1},
                "source_run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
                "snapshot_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "items": {
                  "type": "array", "uniqueItems": true,
                  "items": {
                    "type": "object", "additionalProperties": false,
                    "required": ["key", "disposition"],
                    "properties": {
                      "key": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
                      "disposition": {"enum": ["included", "handled_elsewhere", "discarded"]},
                      "reference": {"type": "string", "minLength": 1, "pattern": "\\S"},
                      "reason": {"type": "string", "minLength": 1, "pattern": "\\S"}
                    }
                  }
                }
              }
            }
          ]
        },
        "deployment": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/deployment"}]},
        "dirty_snapshot": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256", "blob"],
            "properties": {
              "path": {"$ref": "#/$defs/path"},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "blob": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
            }
          }
        },
        "commands": {"type": "array", "items": {"$ref": "#/$defs/command"}},
        "agents": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "builder": {"$ref": "#/$defs/agent"},
            "tester": {"$ref": "#/$defs/agent"},
            "reviewer": {"$ref": "#/$defs/agent"}
          }
        }
      }
    }
  }
}
