{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openai.local/codex-builder-loop/blackbox-case.schema.json",
  "title": "Codex Builder Loop Blackbox Case",
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "dimension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "observation"],
      "properties": {
        "status": {"enum": ["pass", "fail", "not_applicable"]},
        "observation": {"type": "string", "minLength": 1, "pattern": "\\S"}
      }
    },
    "caseResultBase": {
      "type": "object",
      "required": ["case_id", "mechanical", "verify", "quality", "outcome"],
      "properties": {
        "case_id": {"$ref": "#/$defs/id"},
        "mechanical": {"$ref": "#/$defs/dimension"},
        "verify": {"$ref": "#/$defs/dimension"},
        "quality": {"$ref": "#/$defs/dimension"},
        "outcome": {"enum": ["pass", "fail"]}
      }
    },
    "legacyCaseResult": {
      "allOf": [
        {"$ref": "#/$defs/caseResultBase"}
      ],
      "unevaluatedProperties": false
    },
    "boundCaseResult": {
      "allOf": [
        {"$ref": "#/$defs/caseResultBase"},
        {
          "type": "object",
          "required": ["surface_id", "execution_ids"],
          "properties": {
            "surface_id": {"$ref": "#/$defs/id"},
            "execution_ids": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"$ref": "#/$defs/id"}
            },
            "target_id": {"$ref": "#/$defs/id"}
          }
        }
      ],
      "unevaluatedProperties": false
    }
  }
}
