{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openai.local/codex-builder-loop/assurance-v4-runtime-support.schema.json",
  "title": "Assurance v4 runtime support contract",
  "$ref": "#/$defs/manifest",
  "$defs": {
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "gate": {
      "enum": [
        "preflight",
        "machine",
        "tester",
        "proof",
        "blackbox",
        "reviewer_preflight",
        "reviewer",
        "doc_review"
      ]
    },
    "supportSet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "affected_gates",
        "required_independent_gates",
        "path_patterns"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "affected_gates": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/gate"}
        },
        "required_independent_gates": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/gate"}
        },
        "path_patterns": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/path"}
        }
      }
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "support_sets"],
      "properties": {
        "schema_version": {"const": 1},
        "support_sets": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/supportSet"}
        }
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "mode",
        "runtime_head",
        "manifest_blob",
        "manifest_digest",
        "affected_gates",
        "affected_paths"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "mode": {
          "enum": ["self_hosted", "external", "legacy-unavailable"]
        },
        "runtime_head": {
          "oneOf": [
            {"$ref": "#/$defs/commit"},
            {"type": "null"}
          ]
        },
        "manifest_blob": {
          "oneOf": [
            {"$ref": "#/$defs/commit"},
            {"type": "null"}
          ]
        },
        "manifest_digest": {
          "oneOf": [
            {"$ref": "#/$defs/sha256"},
            {"type": "null"}
          ]
        },
        "affected_gates": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/gate"}
        },
        "affected_paths": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/path"}
        }
      }
    }
  }
}
