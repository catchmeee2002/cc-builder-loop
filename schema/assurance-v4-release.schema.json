{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openai.local/codex-builder-loop/assurance-v4-release.schema.json",
  "title": "Builder Assurance v4 Release Intent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "intent_id", "repo_root", "owner_session_id",
    "version", "tag", "release_commit", "snapshot_digest",
    "report_digest", "derivation_identity_digest", "state", "next_stage",
    "receipts", "created_at", "updated_at"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "intent_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "repo_root": {"type": "string", "minLength": 1},
    "owner_session_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "tag": {"type": "string", "pattern": "^v\\S+$"},
    "release_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "snapshot_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "report_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "derivation_identity_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "state": {"enum": ["prepared", "in_progress", "ready", "superseded"]},
    "next_stage": {"enum": ["tag", "github-release", "install-smoke", "complete"]},
    "receipts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stage", "observed", "observed_digest", "verified_at"],
        "properties": {
          "stage": {"enum": ["tag", "github-release", "install-smoke"]},
          "observed": {"type": "object"},
          "observed_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "verified_at": {"type": "string", "minLength": 1}
        }
      },
      "uniqueItems": true
    },
    "created_at": {"type": "string", "minLength": 1},
    "updated_at": {"type": "string", "minLength": 1},
    "superseded_at": {"type": "string", "minLength": 1},
    "superseded_by": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
